# Caddy config for Pantry-to-Plate.
#
# Caddy exists here for one reason: HTTPS. The barcode scanner uses
# navigator.mediaDevices, which browsers only expose on a secure origin — on
# plain http it is not merely blocked, it is undefined. Caddy gets and renews a
# Let's Encrypt certificate on its own, with no cron job to forget about.
#
# Replace the hostname below with yours, then: sudo systemctl reload caddy

your-name.duckdns.org {
	# Fastify serves both the API and the built frontend, so there is exactly
	# one thing behind this and one place for a path to go wrong.
	reverse_proxy localhost:4000

	encode gzip zstd

	header {
		# HTTPS only from now on, including for the service worker.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
	}

	log {
		output file /var/log/caddy/pantry.log
		format console
	}
}
