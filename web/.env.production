# Where the shipped app looks for its backend.
#
# The frontend is bundled inside the binary, so unlike the web build there is no
# same-origin server to fall back on — this has to be absolute, and it is baked
# in at build time. Change it here and rebuild; there is no runtime setting.
VITE_API_URL=https://pantry-to-plate-h55k.onrender.com
