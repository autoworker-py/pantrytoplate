# ---- Database -------------------------------------------------------------
# Local development (SQLite). The file lives at server/prisma/dev.db
DATABASE_URL="file:./dev.db"
#
# Production shape (PostgreSQL). To switch:
#   1. change `provider = "sqlite"` to `provider = "postgresql"` in prisma/schema.prisma
#   2. set DATABASE_URL below, 3. run `npm run migrate:deploy`
# DATABASE_URL="postgresql://user:pass@localhost:5432/pantry?schema=public"

# ---- Auth -----------------------------------------------------------------
# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET="dev-only-change-me-0000000000000000000000000000000000000000"

# ---- External food data ---------------------------------------------------
# USDA FoodData Central. Free key: https://fdc.nal.usda.gov/api-key-signup.html
# "DEMO_KEY" works without signup but is rate limited to ~30 req/hour/IP.
USDA_API_KEY="DEMO_KEY"

# Open Food Facts needs no key. Their policy asks for an identifying User-Agent.
OFF_USER_AGENT="PantryToPlate/0.1 (local development)"

# Set to "true" to hard-disable outbound calls (offline dev / CI).
OFFLINE_MODE="false"

# ---- Server ---------------------------------------------------------------
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# ---- Product defaults -----------------------------------------------------
# Items expiring within this many days are flagged on the dashboard.
EXPIRY_WARNING_DAYS=3

# ---- Email codes ------------------------------------------------------------
# Six-digit codes that confirm an email after sign-up and reset a forgotten
# password, sent through Resend (resend.com). Leave the key empty on a laptop:
# the codes are printed in the server log instead. On a deployed server with no
# key, nothing is emailed and nobody is asked for a code.
RESEND_API_KEY=""
# An address on the domain verified in Resend. Resend's own onboarding address
# only delivers to the email of the Resend account's owner.
EMAIL_FROM="Pantry2Plate <onboarding@resend.dev>"

# ---- Who runs the app --------------------------------------------------------
# Named in the privacy notice (/privacy) and on the support page (/support).
OPERATOR_NAME=""
SUPPORT_EMAIL=""
